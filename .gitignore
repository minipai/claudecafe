node_modules/
notes/
__pycache__/

packages/cafe/dist/

# wrangler local state (the r2 simulator, dev cache)
.wrangler/

# The window's copy of the cast — mirrored out of packages/characters by
# apps/desktop/scripts/pack-sprites.sh, and regenerated rather than kept.
# Checked in it would put another 6 MB of the same artwork into history every
# time a maid is redrawn.
apps/desktop/src/assets/cast/

# macOS leaves these in every folder anyone has opened in Finder.
.DS_Store

# The PNG masters the artwork is generated from — git carries the webp the apps
# actually load; these stay on disk (and in the archive), not in history.
art-masters/

# Operator runbooks — ssh into the droplet, cut a release. Useless to anyone
# who cannot deploy this, and they would load into every contributor's session.
.claude/skills/
