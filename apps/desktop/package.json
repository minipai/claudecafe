{
  "name": "@claudecafe/desktop",
  "productName": "ClaudeCafe",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm sprites >/dev/null && vite",
    "app": "node electron/dev.mjs",
    "build:electron": "node electron/build.mjs",
    "ship:demo": "pnpm sprites >/dev/null && vite build && wrangler deploy",
    "build": "pnpm sprites >/dev/null && tsc -b && vite build && node electron/build.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm sprites >/dev/null && vite build && node electron/build.mjs --fake-sdk && playwright test",
    "check": "pnpm sprites >/dev/null && tsc -b && vitest run",
    "package": "scripts/package.sh",
    "preview": "vite preview",
    "sprites": "scripts/pack-sprites.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "marked": "^17.0.6",
    "motion": "^13.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "main": "dist-electron/main.mjs",
  "license": "MIT"
}
