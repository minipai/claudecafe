  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/load-persona.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
