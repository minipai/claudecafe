{
  "description": "Café hooks for Codex — persona and greeting on session start, plus fresh time context each turn.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load-persona.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session-greeting.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/current-time.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
