{
  "name": "@claudecafe/opencode",
  "version": "0.0.12",
  "private": true,
  "description": "Claude Café for OpenCode — a maid on shift (persona, greeting, per-turn time, mood marker) plus her portrait in the sidebar.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "server.ts",
    "tui.ts",
    "src"
  ],
  "scripts": {
    "build:core": "bash ../../scripts/build-opencode-core.sh",
    "pretest": "pnpm run build:core",
    "test": "bun test ./test",
    "precheck": "pnpm run build:core",
    "prepack": "pnpm run build:core",
    "check": "tsc --noEmit && bun test ./test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.8",
    "@opencode/theme": "2.0.8",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "omggif": "1.0.10",
    "solid-js": "1.9.12",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "@types/omggif": "1.0.5",
    "typescript": "^5.9.0"
  }
}
